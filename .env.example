# Suraksha Parivar Environment Variables

# Application Settings
DEMO_MODE=true
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
WEB_PORT=3000

# Security & Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
EVIDENCE_ENCRYPTION_KEY=super-secret-encryption-key-32-chars-long!
JWT_SECRET=super-secret-jwt-key-for-session-tokens-32-chars!

# LLM API Config (Required if DEMO_MODE=false)
LLM_PROVIDER=mock # Options: mock, openai, gemini
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/suraksha_parivar
REDIS_URL=redis://localhost:6379/0

# PWA & Push Notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
